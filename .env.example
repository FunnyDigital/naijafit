# Copy to .env and adjust. Everything here is optional.

# Host port the site is served on (Docker)
FRONTEND_PORT=8080

# Folder that holds the SQLite database
DATA_DIR=./data

# Shown in the header and browser tab
SITE_TITLE=NaijaFit

# --- accounts ---------------------------------------------------------------
# Signs login tokens. Set this to a long random string; changing it signs
# everyone out. Generate one with:  openssl rand -hex 32
SECRET_KEY=

# Close sign-ups once everyone you know has an account
ALLOW_REGISTRATION=true

# Soft ceiling on accounts so a public URL can't be filled with junk
MAX_USERS=200

# How long a login lasts, in minutes (43200 = 30 days)
ACCESS_TOKEN_EXPIRE_MINUTES=43200
